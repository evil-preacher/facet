<% content_for :title, t("app.personalities.show.page_title", name: @personality.name) %>

<section class="py-10 sm:py-16">
  <div class="h-40 overflow-hidden rounded-3xl bg-slate-900 shadow-xl shadow-slate-200/50 ring-1 ring-slate-200 sm:h-64">
    <%= image_tag "personality-detail.png", alt: "", class: "h-full w-full object-cover object-center", aria: { hidden: true } %>
  </div>

  <div class="mt-8 flex flex-wrap items-start justify-between gap-6">
    <div class="flex items-start gap-5">
      <%= render "personalities/avatar", personality: @personality, class_name: "h-20 w-20 sm:h-24 sm:w-24" %>
      <div>
        <p class="text-xs font-extrabold uppercase tracking-[0.2em] text-emerald-700"><%= t("app.personalities.show.eyebrow") %></p>
        <h1 class="mt-2 text-4xl font-black tracking-tight"><%= @personality.name %></h1>
        <% if @personality.description.present? %>
          <p class="mt-3 max-w-2xl text-lg leading-7 text-slate-600"><%= @personality.description %></p>
        <% end %>
      </div>
    </div>
    <span class="rounded-full bg-white px-3 py-1 text-sm font-bold text-slate-600 ring-1 ring-slate-200"><%= t("app.personalities.statuses.#{@personality.status}") %></span>
  </div>

  <nav data-context-navigation class="sticky top-3 z-30 mt-6 flex flex-wrap gap-2 rounded-2xl bg-slate-50/95 p-2 shadow-lg shadow-slate-200/70 ring-1 ring-slate-200 backdrop-blur" aria-label="<%= t("app.personalities.show.navigation") %>">
    <%= link_to t("app.personalities.show.edit"), edit_personality_path(@personality), class: "rounded-xl bg-emerald-800 px-4 py-2 font-bold text-white no-underline hover:bg-emerald-950" %>
    <%= link_to t("app.personalities.show.history"), personality_versions_path(@personality), class: "rounded-xl bg-white px-4 py-2 font-bold text-emerald-800 no-underline ring-1 ring-slate-300 hover:ring-emerald-700" %>
    <%= link_to t("app.personalities.show.conversations"), personality_conversation_threads_path(@personality), class: "rounded-xl bg-white px-4 py-2 font-bold text-emerald-800 no-underline ring-1 ring-slate-300 hover:ring-emerald-700" %>
    <% if @unread_count.positive? %><span class="rounded-xl bg-emerald-100 px-4 py-2 font-bold text-emerald-900"><%= t("app.initiative.unread_count", count: @unread_count) %></span><% end %>
    <%= link_to t("app.personalities.show.memories"), personality_memories_path(@personality), class: "rounded-xl bg-white px-4 py-2 font-bold text-emerald-800 no-underline ring-1 ring-slate-300 hover:ring-emerald-700" %>
    <%= link_to t("app.personalities.show.relationship_state.title"), "#relationship-state", class: "rounded-xl bg-white px-4 py-2 font-bold text-emerald-800 no-underline ring-1 ring-slate-300 hover:ring-emerald-700" %>
    <%= link_to t("app.personalities.show.back"), personalities_path, class: "rounded-xl bg-white px-4 py-2 font-bold text-emerald-800 no-underline ring-1 ring-slate-300 hover:ring-emerald-700" %>
  </nav>

  <%= button_to t("app.personalities.show.delete"), personality_path(@personality), method: :delete,
                form: { data: { turbo_confirm: t("app.personalities.show.delete_confirm") } },
                class: "mt-4 rounded-xl border border-red-300 px-4 py-2 font-bold text-red-800" %>

  <article id="character-bible" class="mt-6 scroll-mt-24 rounded-3xl bg-white p-7 shadow-sm ring-1 ring-slate-200 sm:p-10">
    <div class="flex items-center justify-between gap-4">
      <h2 class="text-xl font-bold"><%= t("app.personalities.show.character_bible") %></h2>
      <span class="text-sm text-slate-500"><%= t("app.personalities.show.version", number: @personality.current_version.number) %></span>
    </div>
    <div class="mt-6 max-h-[36rem] overflow-y-auto overscroll-contain whitespace-pre-wrap pr-3 font-sans leading-7 text-slate-700" tabindex="0" role="region" aria-label="<%= t("app.personalities.show.character_bible") %>"><%= @personality.current_version.content %></div>
  </article>

  <section class="mt-6 rounded-3xl bg-white p-7 ring-1 ring-slate-200 sm:p-10">
    <h2 class="text-xl font-bold"><%= t("app.initiative.settings_heading") %></h2>
    <p class="mt-2 text-sm text-slate-600"><%= t("app.initiative.settings_description") %></p>
    <% if @settings_errors.present? %><p role="alert" class="mt-3 text-rose-700"><%= @settings_errors.join(", ") %></p><% end %>
    <%= form_with url: initiative_settings_personality_path(@personality), method: :patch, scope: :personality, class: "mt-5 grid gap-4" do |form| %>
      <label class="flex items-center gap-2 font-semibold"><%= form.check_box :initiative_enabled, checked: @personality.initiative_enabled? %><%= t("app.initiative.enabled") %></label>
      <label class="flex items-center gap-2 font-semibold"><%= form.check_box :initiative_email_enabled, checked: @personality.initiative_email_enabled? %><%= t("app.initiative.email_enabled") %></label>
      <p class="text-sm text-slate-600"><%= t("app.initiative.email_description") %></p>
      <div>
        <%= form.label :initiative_idle_hours, t("app.initiative.idle_hours"), class: "block text-sm font-semibold" %>
        <%= form.select :initiative_idle_hours, [12, 24, 48, 72, 168], { selected: @personality.initiative_idle_hours }, class: "mt-1 rounded-lg border border-slate-300 p-2" %>
      </div>
      <div>
        <%= form.label :initiative_cooldown_hours, t("app.initiative.cooldown_hours"), class: "block text-sm font-semibold" %>
        <%= form.select :initiative_cooldown_hours, [24, 48, 72, 168, 336, 720], { selected: @personality.initiative_cooldown_hours }, class: "mt-1 rounded-lg border border-slate-300 p-2" %>
      </div>
      <div>
        <%= form.label :initiative_intensity, t("app.initiative.intensity"), class: "block text-sm font-semibold" %>
        <%= form.select :initiative_intensity, %w[quiet normal expressive].map { |value| [t("app.initiative.intensities.#{value}"), value] }, {}, class: "mt-1 rounded-lg border border-slate-300 p-2" %>
      </div>
      <div>
        <%= form.label :initiative_timezone, t("app.initiative.timezone"), class: "block text-sm font-semibold" %>
        <%= form.time_zone_select :initiative_timezone, nil, {}, class: "mt-1 rounded-lg border border-slate-300 p-2" %>
      </div>
      <div class="flex flex-wrap gap-4">
        <div>
          <%= form.label :initiative_quiet_start_hour, t("app.initiative.quiet_start"), class: "block text-sm font-semibold" %>
          <%= form.select :initiative_quiet_start_hour, (0..23).map { |hour| [format("%02d:00", hour), hour] }, {}, class: "mt-1 rounded-lg border border-slate-300 p-2" %>
        </div>
        <div>
          <%= form.label :initiative_quiet_end_hour, t("app.initiative.quiet_end"), class: "block text-sm font-semibold" %>
          <%= form.select :initiative_quiet_end_hour, (0..23).map { |hour| [format("%02d:00", hour), hour] }, {}, class: "mt-1 rounded-lg border border-slate-300 p-2" %>
        </div>
      </div>
      <%= form.submit t("app.initiative.save"), class: "w-fit cursor-pointer rounded-xl bg-emerald-800 px-5 py-3 font-bold text-white" %>
    <% end %>
  </section>

  <section class="mt-6 rounded-3xl bg-white p-7 ring-1 ring-slate-200 sm:p-10">
    <h2 class="text-xl font-bold"><%= t("app.dynamic_state.heading") %></h2>
    <p class="mt-2 text-sm text-slate-600"><%= t("app.dynamic_state.description") %></p>
    <%= form_with url: dynamic_state_settings_personality_path(@personality), method: :patch,
                  scope: :personality, class: "mt-5 flex flex-wrap items-center gap-4" do |form| %>
      <label class="flex items-center gap-2 font-semibold"><%= form.check_box :dynamic_state_enabled, checked: @personality.dynamic_state_enabled? %><%= t("app.dynamic_state.enabled") %></label>
      <%= form.submit t("app.dynamic_state.save"), class: "cursor-pointer rounded-xl bg-emerald-800 px-5 py-3 font-bold text-white" %>
    <% end %>
    <%= button_to t("app.dynamic_state.reset"), reset_dynamic_state_personality_path(@personality), method: :post,
                  form: { data: { turbo_confirm: t("app.dynamic_state.reset_confirm") } },
                  class: "mt-4 cursor-pointer rounded-xl border border-rose-300 px-4 py-2 font-bold text-rose-800" %>
  </section>

  <article id="relationship-state" class="mt-6 scroll-mt-24 rounded-3xl bg-white p-7 shadow-sm ring-1 ring-slate-200 sm:p-10">
    <div class="flex flex-wrap items-start justify-between gap-4">
      <div>
        <h2 class="text-xl font-bold"><%= t("app.personalities.show.relationship_state.title") %></h2>
        <p class="mt-2 text-sm text-slate-500"><%= t("app.personalities.show.relationship_state.description") %></p>
      </div>
      <% if @relationship_state&.revision&.positive? %>
        <span class="text-sm text-slate-500"><%= t("app.personalities.show.version", number: @relationship_state.revision) %> · <%= l(@relationship_state.updated_at, format: :version) %></span>
      <% end %>
    </div>
    <% if @relationship_state&.summary.present? %>
      <div class="mt-6 whitespace-pre-wrap font-sans leading-7 text-slate-700"><%= @relationship_state.summary %></div>
    <% else %>
      <p class="mt-6 text-slate-500"><%= t("app.personalities.show.relationship_state.empty") %></p>
    <% end %>
  </article>

  <% unless @personality.archived? %>
    <div class="mt-6">
      <%= button_to t("app.personalities.show.archive"),
                    archive_personality_path(@personality),
                    method: :patch,
                    class: "cursor-pointer rounded-xl border-0 bg-rose-50 px-4 py-2 font-bold text-rose-700 hover:bg-rose-100" %>
    </div>
  <% end %>
</section>
