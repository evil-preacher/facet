<% content_for :title, t("app.personalities.edit.page_title", name: @personality.name) %>

<section class="mx-auto mt-8 w-full max-w-3xl overflow-hidden rounded-3xl bg-white shadow-xl shadow-slate-200/60 ring-1 ring-slate-200">
  <div class="h-40 bg-slate-900 sm:h-56">
    <%= image_tag "personality-creation.png", alt: "", class: "h-full w-full object-cover object-center", aria: { hidden: true } %>
  </div>

  <div class="min-w-0 p-6 sm:p-10">
  <p class="text-xs font-extrabold uppercase tracking-[0.2em] text-emerald-700"><%= t("app.personalities.edit.eyebrow") %></p>
  <h1 class="mt-2 text-3xl font-black tracking-tight"><%= t("app.personalities.edit.heading", name: @personality.name) %></h1>
  <p class="mt-3 leading-7 text-slate-600"><%= t("app.personalities.edit.description") %></p>

  <% if @update_errors&.any? %>
    <div class="mt-7 rounded-xl bg-rose-50 p-4 text-rose-800 ring-1 ring-rose-200" role="alert">
      <p class="font-bold"><%= t("app.personalities.errors") %></p>
      <ul class="mt-2 list-disc pl-5 text-sm">
        <% @update_errors.full_messages.each do |message| %>
          <li><%= message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <%= form_with url: personality_path(@personality), scope: :personality, method: :patch, class: "mt-8 grid min-w-0 gap-6" do |form| %>
    <div class="grid min-w-0 gap-2">
      <%= form.label :name, t("app.personalities.fields.name"), class: "font-bold" %>
      <%= form.text_field :name, value: @personality.name, required: true, maxlength: 80, class: "block w-full min-w-0 max-w-full box-border rounded-xl border border-slate-300 px-4 py-3 outline-none focus:border-emerald-700 focus:ring-4 focus:ring-emerald-100" %>
    </div>
    <div class="grid min-w-0 gap-2">
      <%= form.label :description, t("app.personalities.fields.description"), class: "font-bold" %>
      <%= form.text_area :description, value: @personality.description, maxlength: 500, rows: 2, class: "block w-full min-w-0 max-w-full box-border resize-y rounded-xl border border-slate-300 px-4 py-3 outline-none focus:border-emerald-700 focus:ring-4 focus:ring-emerald-100" %>
    </div>
    <div class="grid min-w-0 gap-2">
      <%= form.label :character_bible, t("app.personalities.fields.character_bible"), class: "font-bold" %>
      <p class="text-sm text-slate-500"><%= t("app.personalities.edit.character_bible_hint") %></p>
      <%= form.text_area :character_bible,
                         value: params.dig(:personality, :character_bible) || @personality.current_version.content,
                         required: true,
                         maxlength: PersonalityVersion::MAX_CONTENT_LENGTH,
                         rows: 24,
                         class: "block w-full min-w-0 max-w-full box-border resize-y rounded-xl border border-slate-300 px-4 py-3 font-mono text-sm leading-6 outline-none focus:border-emerald-700 focus:ring-4 focus:ring-emerald-100" %>
    </div>
    <%= form.submit t("app.personalities.edit.submit"), class: "cursor-pointer rounded-xl border-0 bg-emerald-800 px-5 py-3 font-bold text-white hover:bg-emerald-950" %>
  <% end %>
  </div>
</section>
