<article id="<%= dom_id(message) %>" class="flex <%= message.user? ? "justify-end" : "justify-start" %>">
  <div class="max-w-[85%] rounded-2xl px-5 py-4 shadow-sm <%= message.user? ? "bg-emerald-800 text-white" : "bg-white text-slate-800 ring-1 ring-slate-200" %>">
    <div class="chat-markdown <%= "chat-markdown--user" if message.user? %>"
         data-message-content
         <%= "data-markdown-pending" if message.streaming? %>><%= render_message_markdown(message.content) %></div>
    <% if (attachment_url = message_attachment_url(message.attachment)) %>
      <div class="<%= "mt-3" if message.content.present? %> overflow-hidden rounded-xl">
        <%= image_tag attachment_url,
                      alt: t("app.messages.attachment_alt"),
                      class: "max-h-[36rem] w-full rounded-xl object-contain",
                      loading: "lazy" %>
      </div>
    <% end %>
    <% if (message_image = message.message_image) && !message_image.status_declined? %>
      <% image_url = message_image_url(message_image) %>
      <div data-message-image class="mt-3 overflow-hidden rounded-xl bg-slate-100">
        <% if image_url %>
          <%= image_tag image_url, alt: t("app.messages.photo.alt", name: message.conversation_thread.personality.name), class: "max-h-[36rem] w-full rounded-xl object-cover", loading: "lazy" %>
        <% elsif message_image.status_failed? %>
          <p class="px-4 py-3 text-sm text-rose-700"><%= t("app.messages.photo.failed") %></p>
        <% else %>
          <p class="animate-pulse px-4 py-3 text-sm text-slate-500"><%= t("app.messages.photo.generating") %></p>
        <% end %>
      </div>
    <% end %>
    <div class="mt-2 flex flex-wrap items-center gap-2 text-xs <%= message.user? ? "text-emerald-100" : "text-slate-400" %>">
      <span data-message-author>
        <% if message.user? %>
          <%= t("app.messages.roles.user") %>
        <% else %>
          <%= message.conversation_thread.personality.name %>
        <% end %>
      </span>
      <span>·</span>
      <time datetime="<%= message.created_at.iso8601 %>"><%= l(message.created_at, format: :message) %></time>
      <% if message.initiated_by == "personality" %><span><%= t("app.initiative.sent_first") %></span><% end %>
      <% if message.failed? %>
        <span data-message-status class="font-bold text-rose-300"><%= t("app.messages.statuses.failed") %></span>
      <% elsif message.streaming? %>
        <span data-message-status><%= t("app.messages.statuses.streaming") %></span>
      <% elsif message.stopped? %>
        <span data-message-status><%= t("app.messages.statuses.stopped") %></span>
      <% end %>
    </div>
    <% if message.initiated_by == "personality" %>
      <div class="mt-3 text-xs text-slate-500">
        <%= form_with url: initiative_feedback_personality_conversation_thread_message_path(message.conversation_thread.personality, message.conversation_thread, message), method: :patch, class: "flex flex-wrap items-center gap-2" do |form| %>
          <%= form.label :initiative_feedback, t("app.initiative.feedback_label") %>
          <%= form.select :initiative_feedback, %w[helpful irrelevant repetitive unwelcome].map { |kind| [ t("app.initiative.feedback.#{kind}"), kind ] }, { selected: message.initiative_feedback }, class: "rounded-lg border border-slate-300 bg-white px-2 py-1" %>
          <%= form.submit t("app.initiative.feedback_save"), class: "cursor-pointer rounded-lg bg-slate-100 px-2 py-1 font-semibold text-slate-700" %>
        <% end %>
      </div>
    <% end %>
    <% if ai_debug_ui? && message.assistant? %>
      <% model_call = completed_model_call_for(message) %>
      <div data-message-debug
           class="mt-2 font-mono text-[0.7rem] text-slate-400 <%= "hidden" unless model_call %>"><%= model_call_debug_line(model_call) %></div>
    <% end %>
  </div>
</article>
