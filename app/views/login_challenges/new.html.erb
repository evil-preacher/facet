<% content_for :title, t("app.login.title") %>
<section class="mx-auto mt-14 max-w-xl rounded-3xl bg-white p-7 shadow-xl shadow-slate-200/60 ring-1 ring-slate-200 sm:p-10">
  <p class="text-xs font-extrabold uppercase tracking-[0.2em] text-emerald-700"><%= t("app.login.eyebrow") %></p>
  <h1 class="mt-2 text-3xl font-black tracking-tight sm:text-4xl"><%= t("app.login.heading") %></h1>
  <p class="mt-3 leading-7 text-slate-600"><%= t("app.login.description") %></p>
  <%= form_with url: verify_login_path, scope: :login, class: "mt-7 grid gap-3" do |form| %>
    <%= form.hidden_field :token, value: @token %>
    <%= form.label :code, t("app.login.code"), class: "text-sm font-bold" %>
    <%= form.text_field :code, required: true, inputmode: "numeric", autocomplete: "one-time-code", maxlength: 6, pattern: "[0-9]{6}", class: "rounded-xl border border-slate-300 px-4 py-3 text-center text-3xl tracking-[0.4em] outline-none focus:border-emerald-700 focus:ring-4 focus:ring-emerald-100" %>
    <%= form.submit t("app.login.submit"), class: "mt-3 cursor-pointer rounded-xl border-0 bg-emerald-800 px-5 py-3 font-bold text-white hover:bg-emerald-950" %>
  <% end %>
  <%= link_to t("app.login.back"), root_path, class: "mt-7 inline-block text-sm font-semibold text-emerald-800 hover:text-emerald-950" %>
</section>
