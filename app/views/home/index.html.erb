<% content_for :title, t("app.home.title") %>

<section class="mx-auto max-w-3xl py-12 text-center sm:py-20">
  <p class="mb-3 text-xs font-extrabold uppercase tracking-[0.2em] text-emerald-700"><%= t("app.home.eyebrow") %></p>
  <h1 class="text-4xl font-black tracking-tight text-slate-950 sm:text-6xl"><%= t("app.home.heading") %></h1>
  <p class="mx-auto mt-5 max-w-2xl text-lg leading-8 text-slate-600"><%= t("app.home.lead") %></p>
</section>

<%= turbo_frame_tag "authentication" do %>
  <section class="mx-auto max-w-xl rounded-3xl bg-white p-7 shadow-xl shadow-slate-200/60 ring-1 ring-slate-200 sm:p-9">
    <h2 class="text-2xl font-bold"><%= t("app.home.login.title") %></h2>
    <p class="mt-2 leading-6 text-slate-600"><%= t("app.home.login.description") %></p>
    <%= form_with url: login_path, scope: :login, class: "mt-7 grid gap-3", data: { turbo_frame: "_top" } do |form| %>
      <%= form.label :email, t("app.home.email"), class: "text-sm font-bold" %>
      <%= form.email_field :email, required: true, autocomplete: "email", placeholder: "you@example.com", class: "rounded-xl border border-slate-300 bg-white px-4 py-3 outline-none transition focus:border-emerald-700 focus:ring-4 focus:ring-emerald-100" %>
      <%= form.submit t("app.home.login.submit"), class: "mt-3 cursor-pointer rounded-xl border-0 bg-emerald-800 px-5 py-3 font-bold text-white transition hover:bg-emerald-950" %>
    <% end %>
    <p class="mt-7 text-center text-sm text-slate-600">
      <%= t("app.home.login.registration_prompt") %>
      <%= link_to t("app.home.login.registration_link"), new_registration_path,
                  class: "font-bold text-emerald-800 hover:text-emerald-950",
                  data: { turbo_frame: "authentication" } %>
    </p>
  </section>
<% end %>
