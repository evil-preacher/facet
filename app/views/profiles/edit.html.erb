<% content_for :title, t("app.profile.edit_title") %>
<section class="mx-auto mt-12 max-w-2xl rounded-3xl bg-white p-7 shadow-xl shadow-slate-200/60 ring-1 ring-slate-200 sm:p-10">
  <p class="text-xs font-extrabold uppercase tracking-[0.2em] text-emerald-700"><%= t("app.profile.edit_eyebrow") %></p>
  <h1 class="mt-2 text-3xl font-black tracking-tight sm:text-4xl"><%= t("app.profile.heading") %></h1>

  <% if @profile.errors.any? %>
    <div class="mt-6 rounded-xl bg-rose-50 p-4 text-sm text-rose-800 ring-1 ring-rose-200">
      <p class="font-bold"><%= t("app.profile.errors") %></p>
      <ul class="mt-2 list-disc space-y-1 pl-5">
        <% @profile.errors.full_messages.each do |message| %><li><%= message %></li><% end %>
      </ul>
    </div>
  <% end %>

  <%= form_with model: @profile, url: profile_path, method: :patch, class: "mt-7 grid gap-4" do |form| %>
    <div class="grid gap-4 sm:grid-cols-2">
      <div class="grid gap-2">
        <%= form.label :first_name, t("app.profile.first_name"), class: "text-sm font-bold" %>
        <%= form.text_field :first_name, required: true, autocomplete: "given-name", class: "rounded-xl border border-slate-300 px-4 py-3 outline-none focus:border-emerald-700 focus:ring-4 focus:ring-emerald-100" %>
      </div>
      <div class="grid gap-2">
        <%= form.label :last_name, t("app.profile.last_name"), class: "text-sm font-bold" %>
        <%= form.text_field :last_name, required: true, autocomplete: "family-name", class: "rounded-xl border border-slate-300 px-4 py-3 outline-none focus:border-emerald-700 focus:ring-4 focus:ring-emerald-100" %>
      </div>
    </div>
    <%= form.label :gender, t("app.profile.gender"), class: "text-sm font-bold" %>
    <%= form.select :gender, gender_options, { prompt: t("app.profile.gender_prompt") }, required: true, class: "rounded-xl border border-slate-300 bg-white px-4 py-3 outline-none focus:border-emerald-700 focus:ring-4 focus:ring-emerald-100" %>
    <%= form.label :birth_date, t("app.profile.birth_date"), class: "text-sm font-bold" %>
    <%= form.date_field :birth_date, max: Date.current, class: "rounded-xl border border-slate-300 px-4 py-3 outline-none focus:border-emerald-700 focus:ring-4 focus:ring-emerald-100" %>
    <%= form.submit t("app.profile.save"), class: "mt-3 cursor-pointer rounded-xl border-0 bg-emerald-800 px-5 py-3 font-bold text-white hover:bg-emerald-950" %>
  <% end %>
</section>
