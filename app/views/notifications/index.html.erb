<% content_for :title, t("app.notifications.page_title") %>

<section class="mx-auto max-w-3xl py-10 sm:py-16">
  <p class="text-xs font-extrabold uppercase tracking-[0.2em] text-emerald-700"><%= t("app.notifications.eyebrow") %></p>
  <h1 class="mt-2 text-4xl font-black tracking-tight"><%= t("app.notifications.heading") %></h1>
  <p class="mt-3 text-slate-600"><%= t("app.notifications.description") %></p>

  <% if @entries.any? %>
    <div class="mt-8 grid gap-4">
      <% @entries.each do |entry| %>
        <%= link_to personality_conversation_thread_path(entry.personality, entry.thread),
                    class: "block rounded-2xl bg-white p-5 no-underline shadow-sm ring-1 ring-slate-200 hover:ring-emerald-600" do %>
          <div class="flex flex-wrap items-start justify-between gap-3">
            <div>
              <p class="text-sm font-bold text-emerald-800"><%= entry.personality.name %></p>
              <h2 class="mt-1 text-xl font-bold text-slate-950"><%= entry.thread.title %></h2>
            </div>
            <span class="rounded-full bg-emerald-100 px-3 py-1 text-xs font-bold text-emerald-900"><%= t("app.notifications.unread_count", count: entry.count) %></span>
          </div>
          <p class="mt-3 text-sm leading-6 text-slate-600"><%= truncate(entry.last_message.content, length: 180) %></p>
          <time class="mt-2 block text-xs text-slate-500" datetime="<%= entry.last_message.created_at.iso8601 %>"><%= l(entry.last_message.created_at, format: :message) %></time>
        <% end %>
      <% end %>
    </div>
  <% else %>
    <div class="mt-8 rounded-2xl bg-white p-8 text-slate-600 ring-1 ring-slate-200"><%= t("app.notifications.empty") %></div>
  <% end %>
</section>
