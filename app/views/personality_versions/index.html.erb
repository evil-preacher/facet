<% content_for :title, t("app.personalities.versions.index.page_title", name: @personality.name) %>

<section class="py-10 sm:py-16">
  <div class="h-40 overflow-hidden rounded-3xl bg-slate-900 shadow-xl shadow-slate-200/50 ring-1 ring-slate-200 sm:h-64">
    <%= image_tag "personality-history.png", alt: "", class: "h-full w-full object-cover object-center", aria: { hidden: true } %>
  </div>

  <div class="mt-8 flex flex-wrap items-end justify-between gap-5">
    <div>
      <p class="text-xs font-extrabold uppercase tracking-[0.2em] text-emerald-700"><%= t("app.personalities.versions.index.eyebrow") %></p>
      <h1 class="mt-2 text-4xl font-black tracking-tight"><%= t("app.personalities.versions.index.heading", name: @personality.name) %></h1>
      <p class="mt-3 max-w-2xl text-slate-600"><%= t("app.personalities.versions.index.description") %></p>
    </div>
    <%= link_to t("app.personalities.versions.back"), personality_path(@personality), class: "rounded-xl bg-white px-5 py-3 font-bold text-emerald-800 no-underline ring-1 ring-slate-300 hover:ring-emerald-700" %>
  </div>

  <% if @versions.many? %>
    <% version_options = @versions.map { |version| [t("app.personalities.show.version", number: version.number), version.id] } %>
    <%= form_with url: compare_personality_versions_path(@personality), method: :get, class: "mt-8 grid gap-4 rounded-2xl bg-emerald-950 p-5 text-white sm:grid-cols-[1fr_1fr_auto] sm:items-end" do |form| %>
      <div class="grid gap-2">
        <%= form.label :from, t("app.personalities.versions.index.from"), class: "text-sm font-bold" %>
        <%= form.select :from, version_options, { selected: @versions.second.id }, class: "min-w-0 rounded-xl border-0 bg-white px-4 py-3 text-slate-950" %>
      </div>
      <div class="grid gap-2">
        <%= form.label :to, t("app.personalities.versions.index.to"), class: "text-sm font-bold" %>
        <%= form.select :to, version_options, { selected: @versions.first.id }, class: "min-w-0 rounded-xl border-0 bg-white px-4 py-3 text-slate-950" %>
      </div>
      <%= form.submit t("app.personalities.versions.index.compare"), class: "cursor-pointer rounded-xl border-0 bg-amber-300 px-5 py-3 font-bold text-slate-950 hover:bg-amber-200" %>
    <% end %>
  <% end %>

  <div class="mt-8 grid gap-4">
    <% @versions.each do |version| %>
      <% current = version.id == @personality.current_version_id %>
      <article class="rounded-2xl bg-white p-6 shadow-sm ring-1 <%= current ? "ring-emerald-600" : "ring-slate-200" %>">
        <div class="flex flex-wrap items-start justify-between gap-4">
          <div>
            <div class="flex flex-wrap items-center gap-3">
              <h2 class="text-xl font-bold"><%= t("app.personalities.show.version", number: version.number) %></h2>
              <% if current %>
                <span class="rounded-full bg-emerald-100 px-3 py-1 text-xs font-bold text-emerald-800"><%= t("app.personalities.versions.index.current") %></span>
              <% end %>
            </div>
            <p class="mt-2 text-sm text-slate-500">
              <%= t("app.personalities.versions.index.authored_by", author: version.author.email) %>
              · <%= l(version.created_at, format: :version) %>
            </p>
          </div>
          <% unless current %>
            <%= button_to t("app.personalities.versions.index.rollback"),
                          rollback_personality_version_path(@personality, version),
                          method: :post,
                          class: "cursor-pointer rounded-xl border-0 bg-slate-100 px-4 py-2 text-sm font-bold text-slate-700 hover:bg-amber-100",
                          form: { data: { turbo_confirm: t("app.personalities.versions.index.rollback_confirm", number: version.number) } } %>
          <% end %>
        </div>

        <p class="mt-4 leading-6 text-slate-700"><%= version.change_note.presence || t("app.personalities.versions.index.no_note") %></p>
        <% if version.source_version %>
          <p class="mt-2 text-sm font-semibold text-amber-700"><%= t("app.personalities.versions.index.restored_from", number: version.source_version.number) %></p>
        <% end %>
        <details class="mt-4">
          <summary class="cursor-pointer font-bold text-emerald-800"><%= t("app.personalities.versions.index.preview") %></summary>
          <pre class="mt-3 max-h-80 overflow-auto whitespace-pre-wrap rounded-xl bg-slate-950 p-4 text-sm leading-6 text-slate-100"><%= version.content %></pre>
        </details>
      </article>
    <% end %>
  </div>
</section>
