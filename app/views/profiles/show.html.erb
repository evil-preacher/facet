<% content_for :title, t("app.profile.show_title") %>
<section class="mx-auto mt-12 max-w-2xl rounded-3xl bg-white p-7 shadow-xl shadow-slate-200/60 ring-1 ring-slate-200 sm:p-10">
  <p class="text-xs font-extrabold uppercase tracking-[0.2em] text-emerald-700"><%= t("app.profile.show_eyebrow") %></p>
  <h1 class="mt-2 text-3xl font-black tracking-tight sm:text-4xl"><%= @profile.first_name %> <%= @profile.last_name %></h1>
  <dl class="mt-8 divide-y divide-slate-200">
    <div class="grid grid-cols-[140px_1fr] gap-4 py-4"><dt class="text-slate-500"><%= t("app.profile.email") %></dt><dd class="font-semibold"><%= current_user.email %></dd></div>
    <div class="grid grid-cols-[140px_1fr] gap-4 py-4"><dt class="text-slate-500"><%= t("app.profile.gender") %></dt><dd class="font-semibold"><%= t("app.genders.#{@profile.gender}") %></dd></div>
    <% if @profile.birth_date.present? %>
      <div class="grid grid-cols-[140px_1fr] gap-4 py-4"><dt class="text-slate-500"><%= t("app.profile.birth_date") %></dt><dd class="font-semibold"><%= l(@profile.birth_date) %></dd></div>
    <% end %>
  </dl>
  <%= link_to t("app.profile.edit"), edit_profile_path, class: "mt-7 inline-flex rounded-xl bg-emerald-800 px-5 py-3 font-bold text-white no-underline hover:bg-emerald-950" %>
  <div class="mt-8 border-t border-slate-200 pt-6">
    <%= link_to t("app.profile.export_data"), data_export_path, class: "font-bold text-emerald-800" %>
    <%= button_to t("app.profile.delete_account"), account_path, method: :delete,
                  form: { data: { turbo_confirm: t("app.profile.delete_account_confirm") } },
                  class: "mt-5 rounded-xl border border-red-300 px-5 py-3 font-bold text-red-800" %>
  </div>
</section>
