# Optional Docker Compose overrides. The application runs with these defaults
# even when no .env file exists.
UID=1000
GID=1000

POSTGRES_DB=facet_development
POSTGRES_TEST_DB=facet_test
POSTGRES_HOST=db
POSTGRES_PORT=5432
POSTGRES_USER=facet
POSTGRES_PASSWORD=facet

MAILER_HOST=localhost
MAILER_PORT=3000
MAILER_FROM=no-reply@facet.local
SMTP_ADDRESS=mailpit
SMTP_PORT=1025

RAILS_MAX_THREADS=5
REDIS_URL=redis://redis:6379/0
REDIS_NETWORK_TIMEOUT=5
REDIS_POOL_TIMEOUT=5
SIDEKIQ_CONCURRENCY=5
SIDEKIQ_SHUTDOWN_TIMEOUT=25
OUTBOX_POLL_INTERVAL=1

# Required to expose the private operational health endpoint and Sidekiq UI.
OPERATIONS_USERNAME=
OPERATIONS_PASSWORD=

# AI provider credentials and role-based model configuration.
AI_PROVIDER=mistral
MISTRAL_API_KEY=
MISTRAL_BASE_URL=https://api.mistral.ai/v1
MISTRAL_CONVERSATION_MODEL=mistral-large-2512
MISTRAL_UTILITY_MODEL=mistral-small-latest
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_CONVERSATION_MODEL=gpt-4o-2024-11-20
OPENAI_UTILITY_MODEL=gpt-4o-mini
BFL_API_KEY=
BFL_BASE_URL=https://api.bfl.ai/v1
BFL_IMAGE_MODEL=flux-2-klein-9b
BFL_IMAGE_WIDTH=768
BFL_IMAGE_HEIGHT=1024
BFL_SAFETY_TOLERANCE=5
AI_PLATFORM_PROMPT_ENABLED=true
AI_PLATFORM_PROMPT_REQUIRED=false
# Emergency ceiling across all users: 100 USD/month by default (micro-USD).
AI_GLOBAL_MONTHLY_LIMIT_MICROUSD=100000000

# S3-compatible object storage. Docker Compose provides MinIO for development.
# S3_ENDPOINT is used by Rails containers; S3_PUBLIC_ENDPOINT is embedded into
# presigned URLs opened by the host browser.
S3_ENDPOINT=http://minio:9000
S3_PUBLIC_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=facet-development
S3_ACCESS_KEY_ID=facet
S3_SECRET_ACCESS_KEY=facet-development-secret
S3_FORCE_PATH_STYLE=true

# Local diagnostics. Payload logging includes private character and message text.
AI_DEBUG_UI=true
AI_DEBUG_PAYLOADS=false
