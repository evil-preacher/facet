<% content_for :title, t("app.home.title") %>

<div class="py-10 sm:py-16 lg:py-20">
  <div class="grid items-start gap-10 lg:grid-cols-[minmax(0,1fr)_23rem] lg:gap-16">
    <section>
      <p class="text-xs font-extrabold uppercase tracking-[0.2em] text-emerald-700"><%= t("app.home.eyebrow") %></p>
      <h1 class="mt-4 max-w-3xl text-4xl font-black tracking-tight text-slate-950 sm:text-6xl"><%= t("app.home.heading") %></h1>
      <p class="mt-6 max-w-2xl text-lg leading-8 text-slate-600"><%= t("app.home.lead") %></p>
    </section>

    <%= turbo_frame_tag "authentication", class: "block" do %>
      <section class="rounded-3xl bg-white p-7 shadow-xl shadow-slate-200/60 ring-1 ring-slate-200 sm:p-9">
        <h2 class="text-2xl font-bold"><%= t("app.home.login.title") %></h2>
        <p class="mt-2 leading-6 text-slate-600"><%= t("app.home.login.description") %></p>
        <%= form_with url: login_path, scope: :login, class: "mt-7 grid gap-3", data: { turbo_frame: "_top" } do |form| %>
          <%= form.label :email, t("app.home.email"), class: "text-sm font-bold" %>
          <%= form.email_field :email, required: true, autocomplete: "email", placeholder: "you@example.com", class: "rounded-xl border border-slate-300 bg-white px-4 py-3 outline-none transition focus:border-emerald-700 focus:ring-4 focus:ring-emerald-100" %>
          <%= form.submit t("app.home.login.submit"), class: "mt-3 cursor-pointer rounded-xl border-0 bg-emerald-800 px-5 py-3 font-bold text-white transition hover:bg-emerald-950" %>
        <% end %>
        <p class="mt-7 text-center text-sm text-slate-600">
          <%= t("app.home.login.registration_prompt") %>
          <%= link_to t("app.home.login.registration_link"), new_registration_path,
                      class: "font-bold text-emerald-800 hover:text-emerald-950",
                      data: { turbo_frame: "authentication" } %>
        </p>
      </section>
    <% end %>
  </div>

  <figure class="mt-12 overflow-hidden rounded-3xl bg-emerald-950 shadow-xl shadow-slate-300/40 ring-1 ring-slate-200">
    <%= image_tag "facet-memory-personality.png",
                  alt: t("app.home.image_alt"),
                  width: 1672,
                  height: 941,
                  loading: "eager",
                  fetchpriority: "high",
                  class: "aspect-[16/9] w-full object-cover sm:aspect-[12/5]" %>
  </figure>

  <section class="mt-10 grid gap-6 sm:grid-cols-3" aria-label="<%= t("app.home.features.label") %>">
    <% %w[personality memory continuity].each_with_index do |feature, index| %>
      <article class="border-l-2 border-emerald-700 pl-5">
        <p class="text-xs font-extrabold text-emerald-700"><%= format("%02d", index + 1) %></p>
        <h2 class="mt-2 text-lg font-bold text-slate-950"><%= t("app.home.features.#{feature}.title") %></h2>
        <p class="mt-2 leading-6 text-slate-600"><%= t("app.home.features.#{feature}.description") %></p>
      </article>
    <% end %>
  </section>
</div>
