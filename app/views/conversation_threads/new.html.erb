<% content_for :title, t("app.conversation_threads.new.page_title", name: @personality.name) %>

<section class="mx-auto mt-8 w-full max-w-3xl overflow-hidden rounded-3xl bg-white shadow-xl shadow-slate-200/60 ring-1 ring-slate-200">
  <div class="h-40 bg-slate-900 sm:h-56">
    <%= image_tag "conversation-new.png", alt: "", class: "h-full w-full object-cover object-center", aria: { hidden: true } %>
  </div>

  <div class="min-w-0 p-6 sm:p-10">
    <p class="text-xs font-extrabold uppercase tracking-[0.2em] text-emerald-700"><%= t("app.conversation_threads.new.eyebrow") %></p>
    <h1 class="mt-2 text-3xl font-black tracking-tight sm:text-4xl"><%= t("app.conversation_threads.new.heading", name: @personality.name) %></h1>
    <p class="mt-3 leading-7 text-slate-600"><%= t("app.conversation_threads.new.description") %></p>

    <% if @result&.errors&.any? %>
      <div class="mt-7 rounded-xl bg-rose-50 p-4 text-rose-800 ring-1 ring-rose-200" role="alert">
        <p class="font-bold"><%= t("app.conversation_threads.errors") %></p>
        <ul class="mt-2 list-disc pl-5 text-sm">
          <% @result.errors.full_messages.each do |error| %>
            <li><%= error %></li>
          <% end %>
        </ul>
      </div>
    <% end %>

    <%= form_with url: personality_conversation_threads_path(@personality), scope: :conversation_thread, class: "mt-8 grid gap-5" do |form| %>
      <%= form.hidden_field :client_token, value: @client_token %>
      <div class="grid gap-2">
        <%= form.label :content, t("app.conversation_threads.new.message"), class: "font-bold" %>
        <%= form.text_area :content, value: params.dig(:conversation_thread, :content), required: true, maxlength: 10_000, rows: 7, autofocus: true, class: "block w-full min-w-0 resize-y rounded-xl border border-slate-300 px-4 py-3 outline-none focus:border-emerald-700 focus:ring-4 focus:ring-emerald-100" %>
      </div>
      <%= form.submit t("app.conversation_threads.new.submit"), class: "cursor-pointer rounded-xl border-0 bg-emerald-800 px-5 py-3 font-bold text-white hover:bg-emerald-950", data: { turbo_submits_with: t("app.conversation_threads.new.submitting") } %>
    <% end %>

    <%= link_to t("app.conversation_threads.new.back"), personality_conversation_threads_path(@personality), class: "mt-6 inline-block font-bold text-emerald-800" %>
  </div>
</section>
