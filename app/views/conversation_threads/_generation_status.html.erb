<div id="generation_status" class="mt-4" aria-live="polite">
  <% if generation_run&.pending? || generation_run&.running? %>
    <div class="rounded-2xl bg-amber-50 px-5 py-4 text-sm font-semibold text-amber-900 ring-1 ring-amber-200">
      <%= t("app.conversation_threads.generation.generating") %>
    </div>
  <% elsif generation_run&.failed? %>
    <div class="rounded-2xl bg-rose-50 px-5 py-4 text-sm text-rose-800 ring-1 ring-rose-200">
      <p class="font-bold"><%= t("app.conversation_threads.generation.failed") %></p>
      <% if generation_run.error_message.present? %>
        <p class="mt-1"><%= generation_run.error_message %></p>
      <% end %>
      <%= button_to t("app.conversation_threads.generation.retry"),
                    retry_personality_conversation_thread_generation_run_path(@personality, @conversation_thread, generation_run),
                    method: :post,
                    class: "mt-3 cursor-pointer rounded-xl border-0 bg-rose-700 px-4 py-2 font-bold text-white hover:bg-rose-800" %>
    </div>
  <% elsif generation_run&.stopped? %>
    <div class="rounded-2xl bg-slate-100 px-5 py-4 text-sm font-semibold text-slate-600">
      <%= t("app.conversation_threads.generation.stopped") %>
    </div>
  <% end %>
</div>
