<% content_for :title, t("app.conversation_threads.show.page_title", title: @conversation_thread.title) %>

<section class="py-8 sm:py-12">
  <div class="h-36 overflow-hidden rounded-3xl bg-slate-900 shadow-xl shadow-slate-200/50 ring-1 ring-slate-200 sm:h-52">
    <%= image_tag "conversation-active.png", alt: "", class: "h-full w-full object-cover object-center", aria: { hidden: true } %>
  </div>

  <div class="mt-7 flex flex-wrap items-start justify-between gap-5">
    <div>
      <p class="text-xs font-extrabold uppercase tracking-[0.2em] text-emerald-700"><%= @personality.name %></p>
      <h1 id="thread_title" class="mt-2 text-3xl font-black tracking-tight sm:text-4xl"><%= @conversation_thread.title %></h1>
    </div>
    <% if @conversation_thread.active? %>
      <%= button_to t("app.conversation_threads.show.archive"), archive_personality_conversation_thread_path(@personality, @conversation_thread), method: :patch, class: "cursor-pointer rounded-xl border-0 bg-rose-50 px-4 py-2 font-bold text-rose-700 hover:bg-rose-100" %>
    <% end %>
  </div>

  <nav data-context-navigation class="sticky top-3 z-30 mt-5 flex flex-wrap gap-2 rounded-2xl bg-slate-50/95 p-2 shadow-lg shadow-slate-200/70 ring-1 ring-slate-200 backdrop-blur" aria-label="<%= t("app.conversation_threads.show.navigation") %>">
    <%= link_to t("app.conversation_threads.show.personality", name: @personality.name), personality_path(@personality), class: "rounded-xl bg-white px-4 py-2 font-bold text-emerald-800 no-underline ring-1 ring-slate-300 hover:ring-emerald-700" %>
    <%= link_to t("app.conversation_threads.show.all_threads"), personality_conversation_threads_path(@personality), class: "rounded-xl bg-white px-4 py-2 font-bold text-emerald-800 no-underline ring-1 ring-slate-300 hover:ring-emerald-700" %>
  </nav>

  <div class="mt-6 grid gap-6 lg:grid-cols-[15rem_minmax(0,1fr)]">
    <aside class="hidden lg:sticky lg:top-20 lg:block lg:max-h-[calc(100vh-6rem)] lg:self-start lg:overflow-y-auto">
      <h2 class="text-sm font-extrabold uppercase tracking-wide text-slate-500"><%= t("app.conversation_threads.show.other_threads") %></h2>
      <nav class="mt-3 grid gap-2">
        <% @conversation_threads.each do |conversation_thread| %>
          <%= link_to conversation_thread.title,
                      personality_conversation_thread_path(@personality, conversation_thread),
                      class: "rounded-xl px-3 py-2 text-sm font-semibold no-underline #{conversation_thread == @conversation_thread ? "bg-emerald-800 text-white" : "bg-white text-slate-700 ring-1 ring-slate-200 hover:text-emerald-800"}" %>
        <% end %>
      </nav>
    </aside>

    <div class="min-w-0">
      <div id="messages" class="grid gap-4" aria-live="polite">
        <%= render @messages %>
      </div>

      <%= render "conversation_threads/generation_status", generation_run: @latest_generation_run %>
      <%= render "conversation_threads/generation_stream", generation_run: @latest_generation_run %>

      <% if @conversation_thread.active? %>
        <%= render "messages/form",
                   personality: @personality,
                   conversation_thread: @conversation_thread,
                   result: @result,
                   content: params.dig(:message, :content),
                   client_token: @client_token %>
      <% else %>
        <p class="mt-6 rounded-2xl bg-slate-100 p-5 text-sm font-semibold text-slate-600"><%= t("app.conversation_threads.show.archived_notice") %></p>
      <% end %>
    </div>
  </div>
</section>
