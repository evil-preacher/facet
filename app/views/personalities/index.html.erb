<% content_for :title, t("app.personalities.index.page_title") %>

<section class="py-10 sm:py-16">
  <div class="h-40 overflow-hidden rounded-3xl bg-slate-900 shadow-xl shadow-slate-200/50 ring-1 ring-slate-200 sm:h-64">
    <%= image_tag "personality-collection.png", alt: "", class: "h-full w-full object-cover object-center", aria: { hidden: true } %>
  </div>

  <div class="mt-8 flex flex-wrap items-end justify-between gap-5">
    <div>
      <p class="text-xs font-extrabold uppercase tracking-[0.2em] text-emerald-700"><%= t("app.personalities.index.eyebrow") %></p>
      <h1 class="mt-2 text-4xl font-black tracking-tight"><%= t("app.personalities.index.heading") %></h1>
      <p class="mt-3 text-slate-600"><%= t("app.personalities.index.description") %></p>
    </div>
    <%= link_to t("app.personalities.index.new"), new_personality_path, class: "rounded-xl bg-emerald-800 px-5 py-3 font-bold text-white no-underline hover:bg-emerald-950" %>
  </div>

  <% if @personalities.any? %>
    <div class="mt-10 grid gap-5 sm:grid-cols-2">
      <% @personalities.each do |personality| %>
        <article class="rounded-2xl bg-white p-6 shadow-sm ring-1 ring-slate-200">
          <div class="flex items-start gap-4">
            <%= render "personalities/avatar", personality: personality, class_name: "h-16 w-16" %>
            <div class="min-w-0 flex-1">
              <div class="flex items-start justify-between gap-4">
                <h2 class="text-2xl font-bold"><%= link_to personality.name, personality_path(personality), class: "text-slate-950 no-underline hover:text-emerald-800" %></h2>
                <span class="rounded-full bg-slate-100 px-3 py-1 text-xs font-bold text-slate-600"><%= t("app.personalities.statuses.#{personality.status}") %></span>
              </div>
              <% if personality.description.present? %>
                <p class="mt-3 leading-6 text-slate-600"><%= personality.description %></p>
              <% end %>
            </div>
          </div>
        </article>
      <% end %>
    </div>
  <% else %>
    <p class="mt-10 rounded-2xl bg-white p-8 text-slate-600 ring-1 ring-slate-200"><%= t("app.personalities.index.empty") %></p>
  <% end %>
</section>
