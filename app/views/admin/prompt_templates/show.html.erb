<% content_for(:stylesheet) { stylesheet_link_tag "admin_prompts" } %>
<% content_for(:title) { @key.humanize } %>
<header class="main-content__header prompt-admin__header">
  <%= link_to "← #{t('admin.prompts.back')}", admin_prompt_templates_path, class: "prompt-admin__back" %>
  <h1 class="main-content__page-title"><%= @key.humanize %></h1>
  <p class="prompt-admin__meta"><%= @active ? "v#{@active.revision} · #{@active.checksum.first(12)}" : t("admin.prompts.default") %></p>
</header>
<div class="main-content__body prompt-admin">
  <section class="prompt-admin__section">
    <h2><%= t("admin.prompts.content") %></h2>
    <p class="prompt-admin__hint"><%= t("admin.prompts.variables", names: Ai::PromptCatalog::VARIABLES.fetch(@key).map { |name| "{{#{name}}}" }.join(", ").presence || "—") %></p>
    <%= form_with url: publish_admin_prompt_template_path(@key), method: :post, class: "prompt-admin__editor" do |form| %>
      <%= form.label :content, t("admin.prompts.content"), class: "prompt-admin__sr-only" %>
      <%= form.text_area :content, value: @content, rows: 24, spellcheck: false, class: "prompt-admin__textarea" %>
      <div class="prompt-admin__actions">
        <%= form.submit t("admin.prompts.publish"), class: "prompt-admin__primary", data: { turbo_confirm: t("admin.prompts.confirm") } %>
      </div>
    <% end %>
  </section>
  <section class="prompt-admin__section">
    <h2><%= t("admin.prompts.history") %></h2>
    <div class="prompt-admin__history">
      <% if @active %>
        <div class="prompt-admin__revision">
          <div class="prompt-admin__revision-info"><strong><%= t("admin.prompts.default") %></strong></div>
          <%= button_to t("admin.prompts.restore_default"), restore_admin_prompt_template_path(@key), params: { revision_id: "default" }, class: "prompt-admin__restore", data: { turbo_confirm: t("admin.prompts.confirm") } %>
        </div>
      <% end %>
      <% @revisions.each do |revision| %>
        <div class="prompt-admin__revision">
          <div class="prompt-admin__revision-info">
            <strong>v<%= revision.revision %><%= " · #{t('admin.prompts.current')}" if revision == @active %></strong>
            <span><%= revision.created_at.utc.strftime("%Y-%m-%d %H:%M UTC") %> · <%= revision.checksum.first(12) %></span>
            <% if revision.published_by&.email.present? %><span><%= revision.published_by.email %></span><% end %>
          </div>
          <% unless revision == @active %>
            <%= button_to t("admin.prompts.restore"), restore_admin_prompt_template_path(@key), params: { revision_id: revision.id }, class: "prompt-admin__restore", data: { turbo_confirm: t("admin.prompts.confirm") } %>
          <% end %>
        </div>
      <% end %>
    </div>
  </section>
</div>
